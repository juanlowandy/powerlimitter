# Salin file ini menjadi .env.local lalu isi nilainya.
# Di Vercel, isi variabel yang sama di Project Settings > Environment Variables.

# Connection string PostgreSQL dari Neon (pilih yang "Pooled connection")
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Kunci untuk menandatangani cookie login. Buat teks acak dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Kunci rahasia ESP32 (header X-Device-Key). Wajib diisi saat sudah online.
# Isi juga nilai yang sama di DEVICE_KEY pada firmware ESP32.
DEVICE_KEY=

# Akun admin pertama, dipakai oleh `npm run db:setup`
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# Seberapa sering ESP32 mengirim data (ms). 10000 = 10 detik, hemat kuota Vercel & Neon.
REPORT_INTERVAL_MS=10000
